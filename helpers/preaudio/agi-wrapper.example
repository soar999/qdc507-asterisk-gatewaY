#!/bin/sh
set -eu
PATH=/usr/bin:/bin
export PATH
umask 077
case "${1-}" in submit|wait)
 [ "$(cat /etc/qdc507-mode/current)" = 16k ] || exit 78;;
 cancel) ;; *) exit 64;; esac
[ "$#" = 2 ] || exit 64
exec /usr/bin/env -i PATH=/usr/bin:/bin HOME=/var/spool/asterisk/qdc16k-preaudio-state \
 ADB_SERVER_SOCKET=tcp:127.0.0.1:5037 \
 QDC_RUNTIME_ENABLED=exclusive-short-test \
 QDC_LOCAL_STATE=/var/spool/asterisk/qdc16k-preaudio-state \
 QDC_DEVICE_SCRIPT=/tmp/qdc16k-preaudio-manual/device-v2.sh \
 QDC_DEVICE_ROOT=/tmp/qdc16k-preaudio-manual/state \
 QDC_BIN_ROOT=/tmp/qdc507-serial16k-v7 \
 QDC_ADB=/usr/local/bin/adb QDC_SERIAL=__QDC_SERIAL__ \
 /usr/bin/python3 -B /opt/qdc16k-preaudio-manual/preaudio.py "$1" "$2"
