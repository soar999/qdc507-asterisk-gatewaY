#!/usr/bin/env python3
"""Lifecycle preparation only; no audio start."""
import hashlib,os,shlex,subprocess,sys
from pathlib import Path
SERIAL='__QDC_SERIAL__'
DEVICE_HASH='3682a8f0b4160f43778624e8551f39f8390163c92850f6661980ca64038d5f76'
GUARD_HASH='7375b61dc6e8661d02ef17f98097ccae3598782c466b06a50c90ff5454515e71'
REMOTE='/tmp/qdc16k-preaudio-manual'
BIN='/tmp/qdc507-serial16k-v7'
def run(args):
 p=subprocess.run(args,stdin=subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.PIPE,universal_newlines=True,timeout=80)
 if p.returncode:raise RuntimeError('PREAUDIO_PREPARE_COMMAND_FAILED')
 return p.stdout.replace('\r','').strip()
def prepare(adb,payload,active=True):
 payload=Path(payload)
 if payload.is_symlink() or hashlib.sha256(payload.read_bytes()).hexdigest()!=DEVICE_HASH:raise RuntimeError('PREAUDIO_SOURCE_HASH_CHANGED')
 base=[adb,'-H','127.0.0.1','-P','5037','-s',SERIAL]
 code='''set -eu
D=/tmp/qdc16k-preaudio-manual
B=/tmp/qdc507-serial16k-v7
[ ! -L "$D" ]; [ ! -L "$D/state" ]
[ ! -e "$D/state/owner" ]; [ ! -e "$D/state/lock" ]
[ ! -L "$D/state/owner" ]; [ ! -L "$D/state/lock" ]
[ "$(cat /sys/class/android_usb/f_audio/audio_enable)" = 0 ]
for n in 4p 4c 5p 6c; do [ "$(cat /proc/asound/card0/pcm$n/sub0/hw_params)" = closed ]; done
[ -x "$B/bridge-d4" ]; [ -x "$B/bridge-d5" ]; [ -x "$B/run.sh" ]
[ "$(sha256sum "$B/bridge-d4" | cut -d ' ' -f1)" = dc7d080922a6af77128f227b9cee1efc7a6b6d16b42bce859f636ac99e6c523c ]
[ "$(sha256sum "$B/run.sh" | cut -d ' ' -f1)" = 38070547ef168629f32be3fe349b2a517c2fff6177cfe2b6cd15e22c8c6fa778 ]
command -v setsid >/dev/null
[ ! -L "$D/device-v2.sh" ]
[ ! -e "$D/device-v2.sh.upload" ]; [ ! -L "$D/device-v2.sh.upload" ]
'''
 if active:code+='[ "$(sha256sum "$B/bridge-d5" | cut -d " " -f1)" = "'+GUARD_HASH+'" ]\n'
 code+='''if [ -e "$D/device-v2.sh" ]; then
 [ "$(sha256sum "$D/device-v2.sh" | cut -d ' ' -f1)" = "'''+DEVICE_HASH+'''" ]; [ -x "$D/device-v2.sh" ]; echo READY
else echo MISSING; fi'''
 status=run(base+['shell',code])
 if status=='READY':return
 if status!='MISSING':raise RuntimeError('PREAUDIO_PREPARE_UNKNOWN_STATE')
 run(base+['shell','set -eu; umask 077; mkdir -p '+REMOTE+'/state; chmod 700 '+REMOTE+' '+REMOTE+'/state'])
 run(base+['push',str(payload),REMOTE+'/device-v2.sh.upload'])
 run(base+['shell','''set -eu
D=/tmp/qdc16k-preaudio-manual
[ ! -L "$D/device-v2.sh.upload" ]; [ -f "$D/device-v2.sh.upload" ]
[ "$(sha256sum "$D/device-v2.sh.upload" | cut -d ' ' -f1)" = "'''+DEVICE_HASH+'''" ]
[ ! -e "$D/device-v2.sh" ]; [ ! -L "$D/device-v2.sh" ]
chmod 500 "$D/device-v2.sh.upload"
mv "$D/device-v2.sh.upload" "$D/device-v2.sh"
[ "$(sha256sum "$D/device-v2.sh" | cut -d ' ' -f1)" = "'''+DEVICE_HASH+'''" ]'''])
def restore_missing_runtime(adb, root):
    """Recover ONLY a wholly missing /tmp runtime, never repair a partial/unknown one."""
    import json
    root = Path(root)
    hashes = json.loads((root / 'runtime-hashes.json').read_text())
    base = [adb, '-H', '127.0.0.1', '-P', '5037', '-s', SERIAL]
    q = shlex.quote
    state = run(base + ['shell', '''set -eu
B=/tmp/qdc507-serial16k-v7
[ ! -L "$B" ]
if [ -d "$B" ]; then echo PRESENT; else
 [ ! -e "$B" ]; [ ! -e "$B.prepare" ]; [ ! -L "$B.prepare" ]
 [ ! -e /tmp/qdc16k-preaudio-manual/state/owner ]; [ ! -L /tmp/qdc16k-preaudio-manual/state/owner ]
 [ ! -e /tmp/qdc16k-preaudio-manual/state/lock ]; [ ! -L /tmp/qdc16k-preaudio-manual/state/lock ]
 [ "$(cat /sys/class/android_usb/f_audio/audio_enable)" = 0 ]
 for n in 4p 4c 5p 6c; do
  [ "$(cat /proc/asound/card0/pcm$n/sub0/hw_params)" = closed ]
 done
 command -v setsid >/dev/null
 echo ABSENT
fi'''])
    if state == 'PRESENT': return
    if state != 'ABSENT': raise RuntimeError('UNKNOWN_RUNTIME_STATE')
    for n, h in hashes.items():
        p = root / n
        if p.is_symlink() or hashlib.sha256(p.read_bytes()).hexdigest() != h:
            raise RuntimeError('RUNTIME_SOURCE_CHANGED')
    run(base + ['shell', 'umask 077; mkdir '+BIN+'.prepare'])
    for n in sorted(hashes):
        target = BIN+'.prepare/'+n
        run(base + ['push', str(root/n), target])
        run(base + ['shell', 'set -eu; [ "$(sha256sum '+q(target)+' | cut -d " " -f1)" = '+q(hashes[n])+' ]; chmod 700 '+q(target)])
    run(base + ['shell', '''set -eu
B=/tmp/qdc507-serial16k-v7
[ ! -e "$B" ]; [ ! -L "$B" ]
cd "$B.prepare"
mv bridge-d5 bridge-d5-clock8-guard16-base.keep
mv bridge-d5-guard16-pinned.armv7 bridge-d5-clock8-guard16
ln -s "$B/bridge-d5-clock8-guard16" bridge-d5
# No supervisor was started: initialize the existing stopped-state contract.
printf 'DONE d4=0 d5=0\n' > status
mv "$B.prepare" "$B"
'''])

def main():
 if sys.argv[1:]!=['--boot']:raise RuntimeError('USE_EXISTING_LIFECYCLE_ENTRY')
 if Path('/etc/qdc507-mode/current').read_text().strip()!='16k':return
 restore_missing_runtime('/usr/local/bin/adb','/opt/qdc16k-preaudio-manual')
 prepare('/usr/local/bin/adb','/opt/qdc16k-preaudio-manual/device.sh')
 import pwd
 a=pwd.getpwnam('asterisk');p=Path('/var/spool/asterisk/qdc16k-preaudio-state')
 if p.is_symlink():raise RuntimeError('PREAUDIO_STATE_SYMLINK')
 p.mkdir(mode=0o700,exist_ok=True);os.chmod(str(p),0o700);os.chown(str(p),a.pw_uid,a.pw_gid)
if __name__=='__main__':main()
