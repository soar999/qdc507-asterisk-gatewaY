[global]
type=global
endpoint_identifier_order=ip,request_uri,auth_username,username,anonymous

; Public SIP for ipv6.example.com:7777
[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:7777
external_media_address=ipv4.example.com
external_signaling_address=ipv4.example.com
external_signaling_port=7777
local_net=10.6.0.0/22
local_net=172.17.0.0/16
local_net=192.168.1.0/24

[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:7777
external_media_address=ipv4.example.com
external_signaling_address=ipv4.example.com
external_signaling_port=7777
local_net=10.6.0.0/22
local_net=172.17.0.0/16
local_net=192.168.1.0/24

[transport-udp6]
type=transport
protocol=udp
bind=[::]:7777
external_media_address=ipv6.example.com
external_signaling_address=ipv6.example.com
external_signaling_port=7777
local_net=fd00::/8
local_net=fe80::/10

[transport-tcp6]
type=transport
protocol=tcp
bind=[::]:7777
external_media_address=ipv6.example.com
external_signaling_address=ipv6.example.com
external_signaling_port=7777
local_net=fd00::/8
local_net=fe80::/10

; --- extension 100 ---
[100]
type=aor
max_contacts=3
remove_existing=yes
qualify_frequency=30
qualify_timeout=3.0

[100]
type=auth
auth_type=userpass
username=100
password=CHANGE_ME

[100]
message_context=messages-from-100
type=endpoint
context=internal-100
disallow=all
allow=ulaw,alaw,opus,h264,vp8
max_audio_streams=1
max_video_streams=2
auth=100
aors=100
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
media_encryption=no
dtmf_mode=rfc4733
language=en
callerid="Groundwire" <100>
rtp_ipv6=no
bind_rtp_to_media_address=no

; --- extension 101 ---
[101]
type=aor
max_contacts=3
remove_existing=yes
qualify_frequency=30
qualify_timeout=3.0

[101]
type=auth
auth_type=userpass
username=101
password=CHANGE_ME

[101]
message_context=network-test-sms-block
type=endpoint
context=internal
disallow=all
allow=ulaw,alaw,opus,h264,vp8
max_audio_streams=1
max_video_streams=2
auth=101
aors=101
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
media_encryption=no
dtmf_mode=rfc4733
language=en
callerid="Ext 101" <101>
rtp_ipv6=no
bind_rtp_to_media_address=no


; --- extension 103 ---
[103]
type=aor
max_contacts=3
remove_existing=yes
qualify_frequency=30
qualify_timeout=3.0

[103]
type=auth
auth_type=userpass
username=103
password=CHANGE_ME

[103]
message_context=messages-from-103
type=endpoint
identify_by=auth_username,username,ip
context=from-103
disallow=all
allow=ulaw,alaw,opus,h264,vp8
max_audio_streams=1
max_video_streams=2
auth=103
aors=103
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
media_encryption=no
dtmf_mode=rfc4733
language=en
callerid="Ext 103" <103>
rtp_ipv6=no
bind_rtp_to_media_address=no

; Identify unsolicited cellular calls/SMS sent by gateway 103
[identify-103-current-ip]
type=identify
endpoint=103
match=203.0.113.10/32


; --- extension 105 ---
[105]
type=aor
max_contacts=3
remove_existing=yes
qualify_frequency=30
qualify_timeout=3.0

[105]
type=auth
auth_type=userpass
username=105
password=CHANGE_ME

[105]
message_context=messages-from-105
type=endpoint
identify_by=auth_username,username,ip
context=from-105
disallow=all
allow=ulaw,alaw,opus,h264,vp8
max_audio_streams=1
max_video_streams=2
auth=105
aors=105
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
media_encryption=no
dtmf_mode=rfc4733
language=en
callerid="Ext 105" <105>
rtp_ipv6=no
bind_rtp_to_media_address=no

; Outbound SMS control channel for gateway 103 (not the REGISTER contact)
[cloud-trunk]
type=aor
contact=sip:192.0.2.10:5060
qualify_frequency=30
qualify_timeout=3.0

[cloud-trunk]
message_context=network-test-sms-block
type=endpoint
transport=transport-udp
context=from-cloud-trunk
disallow=all
allow=ulaw,alaw
aors=cloud-trunk
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
media_address=192.0.2.20

[cloud-trunk]
type=identify
endpoint=cloud-trunk
match=203.0.113.10/32


; Private trunk to USB QDC507 Asterisk
