#!/bin/sh
set -eu
PATH=/usr/bin:/bin
export PATH
umask 077
case "${1-}" in submit|wait)
 [ "$(cat /etc/qdc507-mode/current)" = 16k ] || exit 78;;
 cancel) ;; *) exit 64;; esac
[ "$#" = 2 ] || exit 64
exec /usr/bin/env -i PATH=/usr/bin:/bin HOME=/var/spool/asterisk/qdc16k-preaudio-state \
 ADB_SERVER_SOCKET=tcp:127.0.0.1:5037 \
 QDC_RUNTIME_ENABLED=exclusive-short-test \
 QDC_LOCAL_STATE=/var/spool/asterisk/qdc16k-preaudio-state \
 QDC_ADB_GATE=/opt/qdc507/runtime/v44-coordination/adb.lock QDC_EPOCH_FILE=/opt/qdc507/runtime/v44-coordination/epoch QDC_PROTECTED_GATE=1 QDC_USB_SYSFS=/sys/bus/usb/devices/1-3.1 QDC_NAS_BOOT_ID=/proc/sys/kernel/random/boot_id QDC_USB_VID=2ca3 QDC_USB_PID=4006 QDC_USB_SYSFS_SERIAL=REDACTED_DEVICE_SERIAL QDC_DEVICE_SCRIPT=/tmp/qdc16k-preaudio-manual/device-v44-event.sh \
 QDC_DEVICE_ROOT=/tmp/qdc16k-preaudio-manual/state \
 QDC_BIN_ROOT=/tmp/qdc507-serial16k-v7 \
 QDC_ADB=/usr/local/bin/adb QDC_SERIAL=REDACTED_DEVICE_SERIAL \
 /usr/bin/python3 -B /opt/qdc507/runtime/v44-coordination/preaudio-v44-candidate.py "$1" "$2"
